<Window x:Class="CupomNaMao.UI.Views.ConfiguracoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — Cupom Na Mão"
    Height="370" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Configurações"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <!-- Opções -->
        <StackPanel Grid.Row="1">

            <!-- Gerar PDF automaticamente -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="ChkGerarAuto"
                          IsChecked="{Binding GerarPdfAutomaticamente}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Gerar PDF automaticamente ao abrir XML"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="O PDF será gerado na mesma pasta do XML"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Abrir PDF após gerar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="ChkAbrirApos"
                          IsChecked="{Binding AbrirPdfAposGerar}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <TextBlock Text="Abrir PDF no visualizador após gerar"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Pasta de destino -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Pasta padrão para salvar PDFs"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Procurar..."
                            Click="BtnProcurarPasta_Click"
                            Padding="10,6"
                            Margin="8,0,0,0"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <TextBox x:Name="TxtPastaDestino"
                             Text="{Binding PastaDestinoPdf}"
                             FontSize="12"
                             Padding="8,6"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </DockPanel>
                <TextBlock Text="Deixe em branco para salvar na mesma pasta do XML"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Mostrar tributos -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="ChkTributos"
                          IsChecked="{Binding MostrarTotalTributos}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <TextBlock Text="Exibir total de tributos aproximados no PDF"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Botões -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Click="BtnCancelar_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"/>
            <Button Content="Salvar"
                    Click="BtnSalvar_Click"
                    Padding="16,8"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
